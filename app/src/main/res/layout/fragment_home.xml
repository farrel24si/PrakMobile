<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    tools:context=".Home.HomeFragment">

    <!-- Header Artistik dengan Wave Background -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@android:color/white" />

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="Selamat Datang,"
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Farrel ADitya Nugraha"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Navigasi Praktikum"
                android:layout_marginBottom="12dp"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- Implementasi GridLayout dengan MaterialButton -->
            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="3"
                app:useDefaultMargins="true">

                <!-- Pertemuan 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 2"
                    app:icon="@android:drawable/ic_menu_today"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <!-- Pertemuan 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 3"
                    app:icon="@android:drawable/ic_menu_day"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <!-- Pertemuan 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP4"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 4"
                    app:icon="@android:drawable/ic_menu_agenda"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <!-- Pertemuan 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 5"
                    app:icon="@android:drawable/ic_menu_view"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <!-- Pertemuan 7 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP7"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 7"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <!-- Pertemuan 9 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP9"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 9"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuP10"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 10"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="textTop"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

            </androidx.gridlayout.widget.GridLayout>

            <!-- Tombol Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Keluar Aplikasi"
                android:backgroundTint="#D32F2F"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_lock_power_off" />

            <TextView
                android:id="@+id/tvCatFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:gravity="center"
                android:text="Loading cat fact..."
                android:textAlignment="center"
                android:textSize="18sp" />
            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="379dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Refresh"
                app:layout_constraintTop_toBottomOf="@+id/tvCatFact" />



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>